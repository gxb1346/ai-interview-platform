<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="AI面试平台 - 压测计划" enabled="true">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ========== 1. 简历异步上传压测 ========== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="① 简历异步上传（50并发）" enabled="true">
        <stringProp name="ThreadGroup.num_threads">50</stringProp>
        <stringProp name="ThreadGroup.ramp_time">2</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <stringProp name="ThreadGroup.duration">60</stringProp>
        <stringProp name="ThreadGroup.delay"/>
      </ThreadGroup>
      <hashTree>
        <!-- 生成唯一文件名（避免 contentHash 去重） -->
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="生成随机文件名" enabled="true">
          <stringProp name="script_language">groovy</stringProp>
          <stringProp name="script"><![CDATA[import java.util.UUID
vars.put("fileName", "简历_" + UUID.randomUUID().toString().substring(0,8) + ".pdf")]]></stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <!-- POST 上传 -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="异步上传简历" enabled="true">
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8082</stringProp>
          <stringProp name="HTTPSampler.path">/api/resume/async-upload</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <stringProp name="HTTPSampler.multipart_post_data">true</stringProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="file" elementType="HTTPArgument">
                <stringProp name="Argument.value">${fileName}</stringProp>
                <stringProp name="Argument.mimetype">application/pdf</stringProp>
                <stringProp name="Argument.path">/path/to/your/test_resume.pdf</stringProp>
              </elementProp>
              <elementProp name="targetJob" elementType="HTTPArgument">
                <stringProp name="Argument.value">Java开发工程师</stringProp>
                <stringProp name="Argument.mimetype">text/plain</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>

        <!-- 断言：返回 taskId 而不是 duplicate -->
        <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言 - 非重复" enabled="true">
          <collectionProp name="Asserion.test_strings">
            <stringProp name="49586">duplicate</stringProp>
          </collectionProp>
          <stringProp name="Assertion.test_field">ASSERTION_RESPONSE_DATA</stringProp>
          <boolProp name="Assertion.assume_success">false</boolProp>
          <intProp name="Assertion.test_type">16</intProp>
        </ResponseAssertion>
        <hashTree/>

        <!-- 聚合报告 -->
        <ResultCollector guiclass="StatGraphVisualizer" testclass="ResultCollector" testname="聚合报告" enabled="true"/>
        <ResultCollector guiclass="GraphVisualizer" testclass="ResultCollector" testname="吞吐量图表" enabled="true"/>
      </hashTree>

      <!-- ========== 2. 监控端点 ========== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="② 压测后查看监控" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <stringProp name="ThreadGroup.delay">60000</stringProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="获取 LLM 监控快照" enabled="true">
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8082</stringProp>
          <stringProp name="HTTPSampler.path">/api/monitor/llm-calls</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>

    </hashTree>
  </hashTree>
</jmeterTestPlan>
